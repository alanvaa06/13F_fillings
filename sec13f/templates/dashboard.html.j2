// Section nav: highlight the last section whose top has scrolled past the sticky header (classic scroll-spy).
(function(){
  const links=[...document.querySelectorAll('.nav a')]; const byId=Object.fromEntries(links.map(a=>[a.getAttribute('href').slice(1), a]));
  const sections=[...document.querySelectorAll('main section[id]')]; const hdr=document.querySelector('header');
  let ticking=false;
  const setHdr=()=>document.documentElement.style.setProperty('--hdr', hdr.offsetHeight+'px');  // keeps anchor jumps clear of the sticky header
  setHdr(); window.addEventListener('resize', setHdr);
  function spy(){
    ticking=false;
    const line = window.scrollY + hdr.offsetHeight + 12;
    let active = sections[0];
    for(const s of sections){ if(s.offsetTop <= line) active = s; }
    if(window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2) active = sections[sections.length-1];
    links.forEach(a=>a.removeAttribute('aria-current')); byId[active.id]?.setAttribute('aria-current','true');
  }
  const onScroll=()=>{ if(!ticking){ ticking=true; setTimeout(spy, 40); } };  // timer, not rAF: rAF is paused in background/hidden tabs
  window.addEventListener('scroll', onScroll, {passive:true}); window.addEventListener('resize', onScroll); spy();
})();

// Light / dark toggle. The attribute is always explicit (set before first paint), the choice persists per browser.
const themeBtn=document.getElementById('theme-toggle'), themeLbl=document.getElementById('theme-label');
function syncThemeButton(){
  const dark=document.documentElement.getAttribute('data-theme')==='dark';
  themeLbl.textContent=dark?'Claro':'Oscuro';
  themeBtn.setAttribute('aria-label', dark?'Cambiar a modo claro':'Cambiar a modo oscuro');
}
themeBtn.onclick=()=>{
  const next=document.documentElement.getAttribute('data-theme')==='dark'?'light':'dark';
  document.documentElement.setAttribute('data-theme', next);
  try{ localStorage.setItem('sec13f-theme', next); }catch(e){}
  syncThemeButton();
};
if (window.matchMedia){
  // Follow the OS only while the user has not made an explicit choice.
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', e=>{
    let saved=null; try{ saved=localStorage.getItem('sec13f-theme'); }catch(err){}
    if(saved!=='light'&&saved!=='dark'){ document.documentElement.setAttribute('data-theme', e.matches?'dark':'light'); syncThemeButton(); }
  });
}
syncThemeButton();
</script>

// ---------- detail
function renderDetail(){
  const sel=document.getElementById('detail-mgr'); const M = DATA.managers.filter(r=>r.period===cur).sort((a,b)=>b.total_value-a.total_value);
  const v=sel.value; sel.innerHTML=M.map(r=>`<option value="${r.cik}">${esc(r.short)}</option>`).join(''); sel.value=[...sel.options].some(o=>o.value===v)?v:M[0].cik;
  const cik=sel.value; const m=M.find(r=>r.cik===cik);
  document.getElementById('detail-meta').textContent = m?`${m.manager} · ${usd(m.total_value)} · ${m.n_positions} posiciones · ${m.manager_type}`:'';
  const H = DATA.holdings.filter(r=>r.period===cur&&r.cik===cik).sort((a,b)=>a.weight-b.weight).slice(-15);
  plot('c-detail-top', [{type:'bar', orientation:'h', x:H.map(r=>r.weight*100), y:H.map(r=>title(r.issuer)+(r.put_call?' ('+r.put_call+')':'')), marker:{color:css('--s1')}, text:H.map(r=>pct(r.weight)), textposition:'outside', textfont:{color:css('--ink2')}, cliponaxis:false,
    customdata:H.map(r=>[usd(r.value_usd), r.asset_type, r.sector]), hovertemplate:'%{y}<br>%{x:.1f}% · %{customdata[0]}<br>%{customdata[1]} · %{customdata[2]}<extra></extra>'}],
    base({xaxis:Object.assign(base().xaxis,{ticksuffix:'%'}), showlegend:false, margin:{l:8,r:50,t:8,b:36}}));
  const S = DATA.mgr_sector.filter(r=>r.period===cur&&r.cik===cik).sort((a,b)=>a.weight-b.weight);
  plot('c-detail-sector', [{type:'bar', orientation:'h', x:S.map(r=>r.weight*100), y:S.map(r=>r.sector), marker:{color:css('--s1')}, text:S.map(r=>pct(r.weight)), textposition:'outside', textfont:{color:css('--ink2')}, cliponaxis:false, hovertemplate:'%{y}: %{x:.1f}%<extra></extra>'}],
    base({xaxis:Object.assign(base().xaxis,{ticksuffix:'%'}), showlegend:false, margin:{l:8,r:50,t:8,b:36}}));
  // changes vs previous quarter: top positions (weight_prev comes from the position diff) and sector weights
  const prev = prevOf(cur);
  document.querySelectorAll('.detail-delta-label').forEach(e=>e.textContent = prev?`${ql(prev)} → ${ql(cur)}`:'');
  const dbar = (id, rows, labelOf, hover) => {
    const el=document.getElementById(id);
    if(!rows.length){ emptyChart(el, 'Sin trimestre previo para comparar.'); return; }
    plot(id, [{type:'bar', orientation:'h', x:rows.map(r=>r.d*100), y:rows.map(labelOf), marker:{color:rows.map(r=>r.d>=0?css('--div-pos'):css('--div-neg'))},
      text:rows.map(r=>pp(r.d)), textposition:'outside', textfont:{color:css('--ink2')}, cliponaxis:false, customdata:rows.map(r=>[pct(r.w0), pct(r.w1)]), hovertemplate:hover}],
      base({xaxis:Object.assign(base().xaxis,{ticksuffix:' pp', zeroline:true, range:divRange(rows.map(r=>r.d*100))}), showlegend:false, margin:{l:8,r:16,t:8,b:36}}));
  };
  if(prev){
    const topD = DATA.holdings.filter(r=>r.period===cur&&r.cik===cik&&r.weight_prev!=null).map(r=>({name:title(r.issuer)+(r.put_call?' ('+r.put_call+')':''), w0:r.weight_prev, w1:r.weight, d:r.weight-r.weight_prev}));
    const exits = DATA.moves.filter(r=>r.period===cur&&r.cik===cik&&r.action==='EXIT').sort((a,b)=>b.weight_prev-a.weight_prev).slice(0,5)
      .map(r=>({name:title(r.issuer)+(r.put_call?' ('+r.put_call+')':'')+' · salida', w0:r.weight_prev, w1:0, d:-r.weight_prev}));
    const rowsT = [...topD, ...exits].sort((a,b)=>a.d-b.d);
    dbar('c-detail-top-delta', rowsT, r=>r.name, '%{y}<br>%{customdata[0]} → %{customdata[1]} (%{x:+.2f} pp)<extra></extra>');
    const S1 = DATA.mgr_sector.filter(r=>r.period===cur&&r.cik===cik), S0 = DATA.mgr_sector.filter(r=>r.period===prev&&r.cik===cik);
    const secs=[...new Set([...S1.map(r=>r.sector), ...S0.map(r=>r.sector)])];
    const rowsS = secs.map(sc=>{const w1=(S1.find(r=>r.sector===sc)||{}).weight||0, w0=(S0.find(r=>r.sector===sc)||{}).weight||0; return {name:sc, w0, w1, d:w1-w0};})
      .filter(r=>Math.abs(r.d)>=0.0005 || r.w1>0.01).sort((a,b)=>a.d-b.d);
    dbar('c-detail-sector-delta', S0.length?rowsS:[], r=>r.name, '%{y}<br>%{customdata[0]} → %{customdata[1]} (%{x:+.2f} pp)<extra></extra>');
  } else { dbar('c-detail-top-delta', [], null, ''); dbar('c-detail-sector-delta', [], null, ''); }
  const A = DATA.managers.filter(r=>r.cik===cik).sort((a,b)=>a.period<b.period?-1:1);
  plot('c-detail-aum', [{type:'scatter', mode:'lines+markers', x:A.map(r=>ql(r.period)), y:A.map(r=>r.total_value/1e9), line:{width:2, color:css('--s1')}, marker:{size:A.map(r=>r.period===cur?10:5), color:css('--s1'), line:{width:2,color:css('--surface')}},
    customdata:A.map(r=>[r.n_positions, pct(r.top10_weight,0), r.turnover==null?'—':pct(r.turnover,0)]), hovertemplate:'%{x}: $%{y:.1f}B<br>%{customdata[0]} posiciones · top-10 %{customdata[1]} · rotación %{customdata[2]}<extra></extra>'}],
    base({xaxis:Object.assign(base().xaxis,{tickangle:-45, nticks:16, showgrid:false}), yaxis:Object.assign(base().yaxis,{tickprefix:'$', ticksuffix:'B', rangemode:'tozero'}), showlegend:false, margin:{l:8,r:16,t:8,b:56}}));
  const rows = DATA.moves.filter(r=>r.period===cur&&r.cik===cik).sort((a,b)=>Math.abs(b.flow_effect)-Math.abs(a.flow_effect)).slice(0,15);
  const el=document.getElementById('t-detail-moves');
  if(!rows.length){ el.innerHTML='<tbody><tr><td class="meta">Sin trimestre previo para comparar.</td></tr></tbody>'; } else movesTable(el, rows, false);
}

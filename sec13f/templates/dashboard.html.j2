<!DOCTYPE html>
<html lang="es">
<meta charset="utf-8">
<title>{{ title }}</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,500;8..60,600&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap">
<script src="https://cdnjs.cloudflare.com/ajax/libs/plotly.js/2.35.3/plotly.min.js"></script>
<style>
:root{
  color-scheme:light;
  --page:#f6f6f3;--surface:#fcfcfb;--ink:#0b0b0b;--ink2:#52514e;--muted:#898781;--grid:#e1e0d9;--axis:#c3c2b7;--border:rgba(11,11,11,.10);
  --accent:#1c5cab;--accent-ink:#ffffff;--up:#006300;--down:#b32d2d;
  --s1:#2a78d6;--s2:#eb6834;--s3:#1baf7a;--s4:#eda100;--s5:#e87ba4;--s6:#008300;--s7:#4a3aa7;--s8:#e34948;
  --div-neg:#e34948;--div-mid:#f0efec;--div-pos:#2a78d6;--seq-lo:#cde2fb;--seq-hi:#0d366b;
  --chip:#eceae3;
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    color-scheme:dark;
    --page:#0d0d0d;--surface:#1a1a19;--ink:#ffffff;--ink2:#c3c2b7;--muted:#898781;--grid:#2c2c2a;--axis:#383835;--border:rgba(255,255,255,.10);
    --accent:#3987e5;--accent-ink:#0b0b0b;--up:#0ca30c;--down:#e66767;
    --s1:#3987e5;--s2:#d95926;--s3:#199e70;--s4:#c98500;--s5:#d55181;--s6:#008300;--s7:#9085e9;--s8:#e66767;
    --div-neg:#e66767;--div-mid:#383835;--div-pos:#3987e5;--seq-lo:#184f95;--seq-hi:#b7d3f6;
    --chip:#262624;
  }
}
:root[data-theme="dark"]{
  color-scheme:dark;
  --page:#0d0d0d;--surface:#1a1a19;--ink:#ffffff;--ink2:#c3c2b7;--muted:#898781;--grid:#2c2c2a;--axis:#383835;--border:rgba(255,255,255,.10);
  --accent:#3987e5;--accent-ink:#0b0b0b;--up:#0ca30c;--down:#e66767;
  --s1:#3987e5;--s2:#d95926;--s3:#199e70;--s4:#c98500;--s5:#d55181;--s6:#008300;--s7:#9085e9;--s8:#e66767;
  --div-neg:#e66767;--div-mid:#383835;--div-pos:#3987e5;--seq-lo:#184f95;--seq-hi:#b7d3f6;
  --chip:#262624;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--page);color:var(--ink);font:15px/1.5 "IBM Plex Sans",system-ui,-apple-system,"Segoe UI",sans-serif}
h1,h2,h3{font-family:"Source Serif 4",Georgia,"Times New Roman",serif;font-weight:600;text-wrap:balance;margin:0}
h1{font-size:30px;line-height:1.15}
h2{font-size:22px;margin:0 0 4px}
h3{font-size:17px;font-weight:600;margin:0 0 8px}
.mono{font-family:"IBM Plex Mono",ui-monospace,Menlo,Consolas,monospace;font-variant-numeric:tabular-nums}
.num{font-variant-numeric:tabular-nums;text-align:right}
a{color:var(--accent)}
header{position:sticky;top:0;z-index:5;background:var(--page);border-bottom:1px solid var(--border)}
.bar{max-width:1240px;margin:0 auto;padding:12px 24px 8px;display:flex;flex-wrap:wrap;gap:12px 24px;align-items:center;justify-content:space-between}
.eyebrow{font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink2);font-weight:500}
.hdr-controls{display:flex;gap:12px 20px;align-items:center;flex-wrap:wrap}
.periods{display:flex;gap:6px;flex-wrap:wrap;align-items:center}
.pill{border:1px solid var(--border);background:var(--surface);color:var(--ink);border-radius:999px;padding:6px 14px;font:inherit;font-size:13px;cursor:pointer}
.pill[aria-pressed="true"]{background:var(--accent);color:var(--accent-ink);border-color:var(--accent)}
select.pill{padding-right:28px;font-weight:600}
.pill:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.theme-toggle{display:inline-flex;align-items:center;gap:8px;padding-left:10px}
.theme-toggle svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.theme-toggle .ico-sun{display:none}
:root[data-theme="dark"] .theme-toggle .ico-sun{display:inline}
:root[data-theme="dark"] .theme-toggle .ico-moon{display:none}
.theme-toggle .lbl{font-size:13px}
.nav{max-width:1240px;margin:0 auto;padding:0 24px;display:flex;gap:2px;overflow-x:auto;scrollbar-width:none}
.nav::-webkit-scrollbar{display:none}
.nav a{font-size:12.5px;font-weight:500;padding:8px 10px 9px;color:var(--ink2);text-decoration:none;border-bottom:2px solid transparent;white-space:nowrap;margin-bottom:-1px}
.nav a:hover{color:var(--ink)}
.nav a[aria-current="true"]{color:var(--ink);border-color:var(--accent)}
main{max-width:1240px;margin:0 auto;padding:8px 24px 64px}
section{padding:28px 0;border-bottom:1px solid var(--border);scroll-margin-top:calc(var(--hdr,120px) + 12px)}
section:last-child{border-bottom:0}
.lede{color:var(--ink2);max-width:68ch;margin:6px 0 0}
.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:0;margin-top:18px;border-top:1px solid var(--border);border-bottom:1px solid var(--border)}
.kpi{padding:16px 18px 14px 0;border-right:1px solid var(--border);margin-right:18px}
.kpi:last-child{border-right:0}
.kpi .l{font-size:12px;letter-spacing:.06em;text-transform:uppercase;color:var(--ink2)}
.kpi .v{font-family:"Source Serif 4",Georgia,serif;font-size:30px;font-weight:500;line-height:1.1;margin-top:6px}
.kpi .d{font-size:13px;color:var(--ink2);margin-top:4px}
.up{color:var(--up)} .down{color:var(--down)}
.grid2{display:grid;grid-template-columns:repeat(auto-fit,minmax(420px,1fr));gap:24px;align-items:start}
.grid3{display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:24px;align-items:start}
.chart{width:100%;min-height:340px}
.chart.tall{min-height:460px}
.insights{list-style:none;padding:0;margin:14px 0 0;display:grid;gap:10px;max-width:90ch}
.insights li{display:grid;grid-template-columns:110px 1fr;gap:14px;align-items:baseline}
.insights .tag{font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--accent);font-weight:600;padding-top:3px}
.controls{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin:10px 0 6px;font-size:13px;color:var(--ink2)}
.controls .sep{width:1px;height:18px;background:var(--border);margin:0 6px}
.controls select,.controls button{font:inherit;font-size:13px;padding:5px 10px;border:1px solid var(--border);border-radius:6px;background:var(--surface);color:var(--ink);cursor:pointer}
.controls button[aria-pressed="true"]{background:var(--accent);color:var(--accent-ink);border-color:var(--accent)}
.controls button:focus-visible,.controls select:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
/* tables: compact, scrollable inside, sticky header + first column, sortable headers */
.tablewrap{overflow:auto;max-height:520px;border:1px solid var(--border);border-radius:8px;background:var(--surface)}
.tablewrap.short{max-height:440px}
table{border-collapse:separate;border-spacing:0;width:100%;font-size:12.5px;line-height:1.35}
th,td{padding:6px 10px;border-bottom:1px solid var(--grid);white-space:nowrap;text-align:left;vertical-align:middle}
th{font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--ink2);font-weight:500;background:var(--surface);position:sticky;top:0;z-index:2;box-shadow:inset 0 -1px 0 var(--grid)}
th.sortable{cursor:pointer;user-select:none}
th.sortable:hover{color:var(--ink)}
th .si{display:inline-block;margin-left:4px;font-size:9px;opacity:.35;transform:translateY(-1px)}
th[aria-sort] .si{opacity:1;color:var(--accent)}
tbody tr:last-child td{border-bottom:0}
tbody tr:hover td{background:color-mix(in srgb,var(--accent) 8%,var(--surface))}
td.num,th.num{text-align:right}
td.txt{max-width:240px;overflow:hidden;text-overflow:ellipsis}
/* frozen leading columns: buildTable(opts.sticky=N) marks the first N cells of every row and sets their left offset */
th.stick,td.stick{position:sticky;background:var(--surface);z-index:1}
th.stick{z-index:3}
td.stick-last,th.stick-last{box-shadow:inset -1px 0 0 var(--grid)}
th.stick-last{box-shadow:inset -1px 0 0 var(--grid),inset 0 -1px 0 var(--grid)}
tbody tr:hover td.stick{background:color-mix(in srgb,var(--accent) 8%,var(--surface))}
td.meta{white-space:normal}
.tcap{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;font-size:12px;color:var(--muted);margin:6px 2px 0}
.chip{display:inline-block;padding:1px 7px;border-radius:4px;font-size:11px;font-weight:600;letter-spacing:.04em;background:var(--chip);color:var(--ink)}
.chip.NEW{background:color-mix(in srgb,var(--s3) 22%,var(--surface));color:var(--ink)}
.chip.ADD{background:color-mix(in srgb,var(--s1) 22%,var(--surface))}
.chip.TRIM{background:color-mix(in srgb,var(--s4) 26%,var(--surface))}
.chip.EXIT{background:color-mix(in srgb,var(--s8) 24%,var(--surface))}
.chip.MAJOR{background:color-mix(in srgb,var(--s1) 26%,var(--surface))}
.chip.MINOR{background:color-mix(in srgb,var(--s4) 22%,var(--surface))}
.chip.NONE{color:var(--ink2)}
.bar-cell{display:flex;align-items:center;gap:8px;justify-content:flex-end}
.bar-cell i{display:block;height:7px;border-radius:2px;background:var(--s1)}
.bar-cell i.neg{background:var(--s8)}
.foot{color:var(--muted);font-size:12.5px;margin-top:8px}
.meta{font-size:13px;color:var(--ink2)}
.legend{display:flex;flex-wrap:wrap;gap:6px 16px;font-size:12.5px;color:var(--ink2);margin:6px 0 0}
.legend span::before{content:"";display:inline-block;width:10px;height:10px;border-radius:2px;margin-right:6px;vertical-align:-1px;background:var(--c)}
@media (max-width:640px){.insights li{grid-template-columns:1fr}.grid2,.grid3{grid-template-columns:1fr}.kpi{border-right:0}}
@media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}html{scroll-behavior:auto}}
</style>

<script>
// Resolve the theme before first paint: saved choice wins, otherwise the OS preference.
(function(){
  let t=null; try{ t=localStorage.getItem('sec13f-theme'); }catch(e){}
  if(t!=='light'&&t!=='dark'){ t=(window.matchMedia&&window.matchMedia('(prefers-color-scheme: dark)').matches)?'dark':'light'; }
  document.documentElement.setAttribute('data-theme', t);
})();
</script>
<header>
<div class="bar">
  <div>
    <div class="eyebrow">SEC EDGAR · Formularios 13F-HR · {{ n_managers }} managers · fuente: {{ source }}</div>
    <h1>{{ title }}</h1>
  </div>
  <div class="hdr-controls">
    <div class="periods" role="group" aria-label="Periodo de reporte">
      <button class="pill" id="p-prev" aria-label="Trimestre anterior">‹</button>
      <select id="period-select" class="pill" aria-label="Trimestre"></select>
      <button class="pill" id="p-next" aria-label="Trimestre siguiente">›</button>
      <span class="meta" id="period-span"></span>
    </div>
    <button class="pill theme-toggle" id="theme-toggle" type="button" aria-label="Cambiar a modo claro">
      <svg class="ico-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      <svg class="ico-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      <span class="lbl" id="theme-label">Claro</span>
    </button>
  </div>
</div>
<nav class="nav" aria-label="Secciones">
  <a href="#s-lead">Resumen</a><a href="#s-history">Histórico</a><a href="#s-asset">Activos</a><a href="#s-sector">Sectores</a><a href="#s-managers">Managers</a>
  <a href="#s-moves">Movimientos</a><a href="#s-companies">Emisoras</a><a href="#s-consensus">Consenso</a><a href="#s-options">Opciones</a><a href="#s-detail">Detalle</a><a href="#s-method">Metodología</a>
</nav>
</header>

<main>
<section id="s-lead">
  <h2 id="headline"></h2>
  <p class="lede">Cambios en tenencias y exposición de {{ n_managers }} instituciones que reportan a la SEC, por tipo de activo, sector, fondo y tipo de manager. Los valores son los reportados en el 13F (posiciones largas en valores 13(f) de EE.UU.), normalizados a dólares.</p>
  <div class="kpis" id="kpis"></div>
  <ul class="insights" id="insights"></ul>
</section>

<section id="s-history">
  <h2>Serie histórica <span class="meta" id="hist-span"></span></h2>
  <p class="lede">Evolución trimestral del universo completo. Las vistas de detalle por posición (movimientos, consenso, opciones, detalle por manager) cubren los últimos <span id="n-detail"></span> trimestres; las series agregadas cubren todo el histórico.</p>
  <div class="grid2">
    <div><h3>Valor reportado del universo</h3><div id="c-hist-value" class="chart"></div></div>
    <div><h3>Flujo neto estimado por trimestre</h3><div id="c-hist-flow" class="chart"></div></div>
  </div>
  <div class="controls" style="margin-top:18px"><span>Ponderación</span><button class="hwbtn" data-w="ew" aria-pressed="true">Equal-weight</button><button class="hwbtn" data-w="vw" aria-pressed="false">Por valor (market weight)</button></div>
  <div class="grid2">
    <div><h3>Mezcla de activos <span class="meta hist-mode-label"></span></h3><div id="c-hist-asset" class="chart tall"></div></div>
    <div><h3>Peso sectorial <span class="meta hist-mode-label"></span> <span class="meta">· 7 mayores + otros</span></h3><div id="c-hist-sector" class="chart tall"></div></div>
  </div>
  <div class="grid3" style="margin-top:20px">
    <div><h3>Managers reportando</h3><div id="c-hist-mgrs" class="chart" style="min-height:240px"></div></div>
    <div><h3>Concentración promedio (top-10)</h3><div id="c-hist-top10" class="chart" style="min-height:240px"></div></div>
    <div><h3>Rotación promedio</h3><div id="c-hist-turnover" class="chart" style="min-height:240px"></div></div>
  </div>
</section>

<section id="s-asset">
  <h2>Exposición por tipo de activo</h2>
  <p class="lede">Composición del valor reportado por instrumento subyacente. <em>Equal-weight</em> promedia la asignación de cada manager (cada filer pesa igual); <em>por valor</em> (market weight) suma dólares y queda dominada por los filers más grandes.</p>
  <div class="controls"><span>Ponderación</span><button class="wbtn" data-w="ew" aria-pressed="true">Equal-weight</button><button class="wbtn" data-w="vw" aria-pressed="false">Por valor (market weight)</button></div>
  <div class="grid2">
    <div><h3>Mezcla por trimestre (últimos <span class="n-detail"></span>)</h3><div id="c-asset-mix" class="chart"></div></div>
    <div><h3>Cambio vs. trimestre anterior <span class="meta" id="asset-delta-label"></span></h3><div id="c-asset-delta" class="chart"></div></div>
  </div>
</section>

<section id="s-sector">
  <h2>Rotación sectorial</h2>
  <p class="lede">Peso por sector y su variación trimestral. <em>Equal-weight</em> promedia el peso que cada manager asigna al sector; <em>por valor</em> (market weight) es la participación del sector en los dólares agregados del universo. Los ETFs se agrupan por su exposición (renta variable amplia, internacional, renta fija, commodities, sectoriales).</p>
  <div class="controls"><span>Ponderación</span><button class="swbtn" data-w="ew" aria-pressed="true">Equal-weight</button><button class="swbtn" data-w="vw" aria-pressed="false">Por valor (market weight)</button></div>
  <div class="grid2">
    <div><h3>Peso por sector <span class="meta" id="sector-mode-label"></span></h3><div id="c-sector-level" class="chart tall"></div></div>
    <div><h3>Variación del peso (pp) <span class="meta" id="sector-delta-label"></span></h3><div id="c-sector-delta" class="chart tall"></div></div>
  </div>
  <h3 style="margin-top:20px">Flujo neto por tipo de manager y sector <span class="meta">(% del valor del grupo)</span></h3>
  <div id="c-rotation-heat" class="chart"></div>
  <p class="foot">Flujo = Δ títulos × precio implícito del trimestre; excluye el efecto de precio. Azul = compras netas, rojo = ventas netas.</p>
</section>

<section id="s-managers">
  <h2>Managers: tamaño, concentración y rotación</h2>
  <p class="lede">Huella de cartera de cada filer. El <em>tipo inferido</em> se deriva de la cartera (número de posiciones, concentración, opciones, ETFs, rotación) y se compara con el tipo declarado en la configuración.</p>
  <div class="grid2">
    <div>
      <h3>Concentración vs. amplitud</h3>
      <div class="controls" style="margin-top:0"><span>Etiquetas</span><button id="lbl-btn" aria-pressed="true">Mostrar nombres</button></div>
      <div id="c-mgr-scatter" class="chart tall"></div>
      <p class="foot"><strong>Concentración</strong> = peso de las 10 mayores posiciones en el libro (eje Y). <strong>Amplitud</strong> = número de posiciones reportadas (eje X, escala logarítmica). Arriba a la izquierda quedan las carteras concentradas y estrechas (activistas, valor concentrado); abajo a la derecha, los libros amplios y diversificados (índices, quant, multi-estrategia). Tamaño del marcador ∝ log del valor reportado.</p>
    </div>
    <div><h3>Rotación estimada por manager</h3><div id="c-mgr-turnover" class="chart tall"></div></div>
  </div>
  <div class="tablewrap" style="margin-top:18px"><table id="t-managers"></table></div>
  <p class="tcap"><span id="cap-managers"></span><span>Clic en un encabezado para ordenar; pasa el cursor sobre el tipo inferido para ver el motivo.</span></p>
</section>

<section id="s-moves">
  <h2>Movimientos del trimestre</h2>
  <p class="lede">Posiciones nuevas, salidas, aumentos y reducciones. Por defecto se muestran las 40 de mayor flujo estimado; el peso previo y el actual son la participación de la posición en el libro del manager.</p>
  <div class="controls"><span>Acción</span>
    <button class="abtn" data-a="ALL" aria-pressed="true">Todas</button><button class="abtn" data-a="NEW">Nuevas</button><button class="abtn" data-a="EXIT">Salidas</button><button class="abtn" data-a="ADD">Aumentos</button><button class="abtn" data-a="TRIM">Reducciones</button>
    <span class="sep"></span><span>Manager</span><select id="moves-mgr"><option value="ALL">Todos</option></select>
  </div>
  <div class="tablewrap"><table id="t-moves"></table></div>
  <p class="tcap"><span id="cap-moves"></span><span>Clic en un encabezado para ordenar.</span></p>
</section>

<section id="s-companies">
  <h2>Cambios agregados por emisora</h2>
  <p class="lede">Qué compañías compró y vendió el universo en conjunto, sumando las operaciones de todos los managers que reportaron ambos trimestres (solo acciones directas: común, ADR, REIT). <em>Δ títulos</em> es la variación % de los títulos agregados en manos del universo, independiente del precio; el flujo neto es en dólares al precio del trimestre.</p>
  <div class="kpis" id="companies-kpis"></div>
  <div class="controls"><span>Ranking por</span>
    <button class="cmbtn" data-m="flow" aria-pressed="true">Flujo neto ($)</button><button class="cmbtn" data-m="pct">Δ títulos (%)</button><button class="cmbtn" data-m="breadth">Compradores netos</button>
  </div>
  <div class="grid2">
    <div><h3>Más compradas <span class="meta" id="companies-buy-label"></span></h3><div id="c-companies-buy" class="chart tall"></div></div>
    <div><h3>Más vendidas <span class="meta" id="companies-sell-label"></span></h3><div id="c-companies-sell" class="chart tall"></div></div>
  </div>
  <p class="foot" id="companies-foot"></p>
  <div class="controls" style="margin-top:14px"><span>Cambio neto</span>
    <button class="cgbtn" data-g="ALL" aria-pressed="true">Todos</button><button class="cgbtn" data-g="MAJOR">Mayor</button><button class="cgbtn" data-g="MINOR">Menor</button><button class="cgbtn" data-g="NONE">Sin cambio</button>
    <span class="sep"></span><span>Sector</span><select id="companies-sector"><option value="ALL">Todos</option></select>
  </div>
  <div class="tablewrap"><table id="t-companies"></table></div>
  <p class="tcap"><span id="cap-companies"></span><span>Mayor: |Δ títulos| ≥ 10 % o ≥ 3 compradores/vendedores netos con |Δ| ≥ 3 %; menor: ≥ 1 %; sin cambio: por debajo. Las entradas nuevas al universo cuentan como mayor.</span></p>
</section>

<section id="s-consensus">
  <h2>Consenso y crowding</h2>
  <p class="lede">Valores más compartidos entre managers y dirección neta de las operaciones (compradores menos vendedores, excluyendo puts).</p>
  <div class="grid3">
    <div><h3>Más tenidos</h3><div class="tablewrap short"><table id="t-held"></table></div></div>
    <div><h3>Compras de consenso</h3><div class="tablewrap short"><table id="t-bought"></table></div></div>
    <div><h3>Ventas de consenso</h3><div class="tablewrap short"><table id="t-sold"></table></div></div>
  </div>
</section>

<section id="s-options">
  <h2>Opciones: puts vs. calls</h2>
  <p class="lede">Nocional del subyacente reportado en puts y calls, por emisor. Una lectura de cobertura o de apuestas direccionales; el 13F no distingue entre opciones compradas y suscritas.</p>
  <div id="c-putcall" class="chart tall"></div>
</section>

<section id="s-detail">
  <h2>Detalle por manager</h2>
  <div class="controls"><span>Manager</span><select id="detail-mgr"></select><span id="detail-meta" class="meta"></span></div>
  <div class="grid2">
    <div><h3>Principales posiciones</h3><div id="c-detail-top" class="chart tall"></div></div>
    <div><h3>Exposición sectorial del manager</h3><div id="c-detail-sector" class="chart tall"></div></div>
  </div>
  <div class="grid2" style="margin-top:20px">
    <div><h3>Cambio en principales posiciones <span class="meta detail-delta-label"></span></h3><div id="c-detail-top-delta" class="chart tall"></div><p class="foot">Δ del peso en el libro del manager para sus 15 mayores posiciones actuales y las salidas más grandes del trimestre.</p></div>
    <div><h3>Cambio en exposición sectorial <span class="meta detail-delta-label"></span></h3><div id="c-detail-sector-delta" class="chart tall"></div><p class="foot">Δ del peso sectorial del manager frente al trimestre previo (puntos porcentuales).</p></div>
  </div>
  <h3 style="margin-top:18px">Valor reportado del manager en el tiempo</h3>
  <div id="c-detail-aum" class="chart" style="min-height:260px"></div>
  <h3 style="margin-top:18px">Cambios del trimestre</h3>
  <div class="tablewrap short"><table id="t-detail-moves"></table></div>
</section>

<section id="s-method">
  <h2>Metodología y límites</h2>
  <div class="grid2">
    <div>
      <h3>Pipeline</h3>
      <p class="meta">1) Descubrimiento de filings vía <span class="mono">data.sec.gov/submissions</span> · 2) descarga del <span class="mono">informationTable</span> XML y la portada · 3) parseo y normalización (valores a USD, agregación de sub-managers) · 4) clasificación de activo y sector con score de confianza · 5) diff trimestral y descomposición flujo/precio · 6) agregación por manager, tipo de manager, sector y tipo de activo.</p>
    </div>
    <div>
      <h3>Qué no ve el 13F</h3>
      <p class="meta">Posiciones cortas, bonos soberanos, derivados OTC, acciones extranjeras sin ADR, efectivo y posiciones confidenciales. Rezago de hasta 45 días tras el cierre del trimestre. Las opciones se reportan por nocional del subyacente. Los cambios de precio implícito son aproximaciones (valor/títulos).</p>
    </div>
  </div>
  <p class="foot">Generado {{ generated_at }} · {{ n_filings }} filings · {{ n_rows }} renglones de tenencias · sec13f v{{ version }}</p>
</section>
</main>

<script id="data" type="application/json">{{ data_json }}</script>
<script>
const DATA = JSON.parse(document.getElementById('data').textContent);
const ALLP = DATA.periods; const P = DATA.detail_periods; let cur = P[P.length-1]; let wmode = 'ew'; let smode = 'ew'; let hmode = 'ew'; let amode = 'ALL'; let mgrLabels = true; let cmetric = 'flow'; let cmag = 'ALL';
const css = n => getComputedStyle(document.documentElement).getPropertyValue(n).trim();
const SERIES = () => ['--s1','--s2','--s3','--s4','--s5','--s6','--s7','--s8'].map(css);
const usd = x => { if (x==null||isNaN(x)) return '—'; const a=Math.abs(x), s=x<0?'-':''; if(a>=1e12) return s+'$'+(a/1e12).toFixed(2)+'T'; if(a>=1e9) return s+'$'+(a/1e9).toFixed(1)+'B'; if(a>=1e6) return s+'$'+(a/1e6).toFixed(0)+'M'; return s+'$'+a.toFixed(0); };
const pct = (x,d=1) => (x==null||isNaN(x))?'—':(x*100).toFixed(d)+'%';
const pp = x => (x==null||isNaN(x))?'—':((x>=0?'+':'')+(x*100).toFixed(1)+' pp');
const ql = p => p.slice(0,4)+'Q'+(Math.floor((+p.slice(5,7)-1)/3)+1);
const ACR = new Set(['ETF','ADR','ADS','MSCI','EAFE','S&P','SPDR','REIT','PFD','NV','SA','AG','PLC','LLC','LP','USA','US','FTSE','QQQ','AT&T','IBM','HCA','CVS','GE','RTX','KKR','PNC','TJX','UPS','PDD','JD','ASML','SAP','TSM','NVR']);
const title = s => String(s||'').split(' ').map(w => (w.startsWith('(')&&w.endsWith(')'))||ACR.has(w.toUpperCase()) ? w.toUpperCase() : w.charAt(0).toUpperCase()+w.slice(1).toLowerCase()).join(' ');
const esc = s => String(s??'').replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const prevOf = p => { const i=P.indexOf(p); return i>0?P[i-1]:null; };
const signed = (v, f) => `<span class="${v>0?'up':v<0?'down':''}">${f(v)}</span>`;
// x-range for diverging horizontal bars with "outside" text: pad both sides so labels on negative bars do not run into the axis labels
const divRange = vals => { const lo=Math.min(0,...vals), hi=Math.max(0,...vals); const pad=Math.max(hi-lo, 1e-9)*0.24; return [lo-pad, hi+pad]; };
const CFG = {displayModeBar:false, responsive:true};
function base(extra){
  return Object.assign({
    paper_bgcolor:'rgba(0,0,0,0)', plot_bgcolor:'rgba(0,0,0,0)',
    font:{family:'"IBM Plex Sans",system-ui,sans-serif', size:12.5, color:css('--ink2')},
    margin:{l:8,r:16,t:8,b:36}, hovermode:'closest',
    hoverlabel:{bgcolor:css('--surface'), bordercolor:css('--border'), font:{color:css('--ink'), size:12.5}},
    xaxis:{gridcolor:css('--grid'), zerolinecolor:css('--axis'), linecolor:css('--axis'), tickfont:{color:css('--muted')}, automargin:true},
    yaxis:{gridcolor:css('--grid'), zerolinecolor:css('--axis'), linecolor:css('--axis'), tickfont:{color:css('--muted')}, automargin:true},
    legend:{orientation:'h', y:-0.18, x:0, font:{color:css('--ink2')}},
  }, extra||{});
}
// Every chart gets an explicit height (its CSS min-height unless the layout says otherwise). Without it Plotly's responsive
// sizing re-measures a container whose height depends on the previous render and charts grow on each re-render.
function plot(id, traces, layout){
  const el = typeof id==='string' ? document.getElementById(id) : id;
  if(!el.classList.contains('js-plotly-plot') && el.firstChild) el.innerHTML='';  // container currently holds an empty-state message
  const h = layout.height || parseFloat(getComputedStyle(el).minHeight) || 340;
  layout.height = h; el.style.height = h+'px';
  return Plotly.react(el, traces, layout, CFG);
}
// Empty state for a chart container. Never wipe a Plotly div's innerHTML by hand: Plotly keeps internal state on the element
// and the next react() call would diff against nodes that no longer exist and draw nothing.
function emptyChart(el, msg){
  if(el.classList.contains('js-plotly-plot')) Plotly.purge(el);
  el.style.height=''; el.innerHTML=`<p class="meta">${esc(msg)}</p>`;
}

// ---------- generic sortable table
// cols: [{k, h, cls, f(row)->html, s(row)->sort value, tip, nosort}]. Sort state survives re-renders (period change, theme change).
const SORT = {};
function buildTable(el, cols, rows, opts){
  opts = opts||{};
  const st = SORT[el.id] || (SORT[el.id] = {k: opts.defaultKey ?? null, dir: opts.defaultDir ?? -1});
  const col = cols.find(c=>c.k===st.k);
  let data = [...rows];
  if(col){
    const sv = col.s || (r=>r[col.k]);
    data.sort((a,b)=>{
      const x=sv(a), y=sv(b); const nx=(x==null||x!==x), ny=(y==null||y!==y);
      if(nx&&ny) return 0; if(nx) return 1; if(ny) return -1;
      if(typeof x==='number'&&typeof y==='number') return (x-y)*st.dir;
      return String(x).localeCompare(String(y),'es',{numeric:true,sensitivity:'base'})*st.dir;
    });
  }
  const icon = c => c.nosort?'':`<span class="si" aria-hidden="true">${c.k===st.k?(st.dir>0?'▲':'▼'):'⇅'}</span>`;
  const head = '<thead><tr>'+cols.map(c=>`<th class="${c.cls||''}${c.nosort?'':' sortable'}"${c.k===st.k?` aria-sort="${st.dir>0?'ascending':'descending'}"`:''} data-k="${esc(c.k)}"${c.tip?` title="${esc(c.tip)}"`:''}>${esc(c.h)}${icon(c)}</th>`).join('')+'</tr></thead>';
  const body = '<tbody>'+(data.length ? data.map(r=>'<tr>'+cols.map(c=>`<td class="${c.cls||''}">${c.f?c.f(r):esc(r[c.k]??'')}</td>`).join('')+'</tr>').join('')
                                      : `<tr><td colspan="${cols.length}" class="meta">${esc(opts.empty||'Sin datos para este trimestre.')}</td></tr>`)+'</tbody>';
  el.innerHTML = head+body;
  if(opts.sticky){ // freeze the first N columns: measure header widths, then pin each cell with its cumulative left offset
    const n=Math.min(opts.sticky, cols.length); const ths=[...el.querySelectorAll('thead th')]; const lefts=[]; let acc=0;
    for(let i=0;i<n;i++){ lefts.push(acc); acc+=ths[i].offsetWidth; }
    el.querySelectorAll('tr').forEach(tr=>{ for(let i=0;i<n&&i<tr.children.length;i++){ const c=tr.children[i]; if(c.colSpan>1) break; c.classList.add('stick'); if(i===n-1) c.classList.add('stick-last'); c.style.left=lefts[i]+'px'; } });
  }
  el.querySelectorAll('th.sortable').forEach(th=>th.onclick=()=>{
    const k=th.dataset.k; const c=cols.find(c=>c.k===k);
    if(st.k===k) st.dir=-st.dir; else { st.k=k; st.dir = (c.cls||'').includes('num') ? -1 : 1; }
    buildTable(el, cols, rows, opts);
  });
}

// ---------- header
function renderPeriods(){
  const sel=document.getElementById('period-select');
  if(!sel.options.length){ P.forEach(p=>{ const o=document.createElement('option'); o.value=p; o.textContent=ql(p); sel.appendChild(o); }); sel.onchange=()=>{cur=sel.value; renderAll();};
    document.getElementById('p-prev').onclick=()=>{const i=P.indexOf(cur); if(i>0){cur=P[i-1]; renderAll();}};
    document.getElementById('p-next').onclick=()=>{const i=P.indexOf(cur); if(i<P.length-1){cur=P[i+1]; renderAll();}}; }
  sel.value=cur; document.getElementById('period-span').textContent=`cierre ${cur}`;
  document.querySelectorAll('.n-detail,#n-detail').forEach(e=>e.textContent=P.length);
  document.getElementById('hist-span').textContent=`${ql(ALLP[0])} – ${ql(ALLP[ALLP.length-1])}`;
}
// ---------- history
function renderHistory(){
  const H = DATA.history; const x = H.map(r=>ql(r.period)); const S=SERIES();
  const ax = (o)=>Object.assign(base().xaxis, {tickangle:-45, nticks:16, showgrid:false}, o||{});
  plot('c-hist-value', [{type:'bar', x, y:H.map(r=>r.total_value/1e12), marker:{color:css('--s1')}, hovertemplate:'%{x}: $%{y:.2f}T<extra></extra>'}],
    base({xaxis:ax(), yaxis:Object.assign(base().yaxis,{tickprefix:'$', ticksuffix:'T', rangemode:'tozero'}), showlegend:false, bargap:0.25}));
  const fl = H.filter(r=>r.net_flow!=null);
  plot('c-hist-flow', [{type:'bar', x:fl.map(r=>ql(r.period)), y:fl.map(r=>r.net_flow/1e9), marker:{color:fl.map(r=>r.net_flow>=0?css('--div-pos'):css('--div-neg'))}, hovertemplate:'%{x}: $%{y:.1f}B<extra></extra>'}],
    base({xaxis:ax(), yaxis:Object.assign(base().yaxis,{tickprefix:'$', ticksuffix:'B', zeroline:true}), showlegend:false, bargap:0.25}));
  const hk = hmode==='ew'?'avg_weight':'share'; const hl = hmode==='ew'?'(equal-weight)':'(por valor)';
  document.querySelectorAll('.hist-mode-label').forEach(e=>e.textContent=hl);
  const EA = DATA.exposure_asset;
  plot('c-hist-asset', ASSET_ORDER.map((a,i)=>({type:'scatter', mode:'lines', stackgroup:'one', name:a, x, y:ALLP.map(p=>{const r=EA.find(r=>r.period===p&&r.underlying_asset===a); return r&&r[hk]!=null?r[hk]*100:0;}),
    line:{width:0.5, color:css('--surface')}, fillcolor:S[i%8], hovertemplate:'%{x} · '+a+': %{y:.1f}%<extra></extra>'})),
    base({xaxis:ax(), yaxis:Object.assign(base().yaxis,{ticksuffix:'%', range:[0,100]}), margin:{l:8,r:16,t:8,b:90}, legend:{orientation:'h',y:-0.32,x:0}, hovermode:'x unified'}));
  const ES = DATA.exposure_sector; const secs=[...new Set(ES.map(r=>r.sector))];
  const avg = secs.map(sc=>({sc, m: ES.filter(r=>r.sector===sc).reduce((a,r)=>a+(r[hk]||0),0)})).sort((a,b)=>b.m-a.m);
  const top = avg.slice(0,7).map(a=>a.sc), rest = avg.slice(7).map(a=>a.sc);
  const series = top.map((sc,i)=>({type:'scatter', mode:'lines', name:sc, x, y:ALLP.map(p=>{const r=ES.find(r=>r.period===p&&r.sector===sc); return r&&r[hk]!=null?r[hk]*100:null;}), line:{width:2, color:S[i]}, hovertemplate:'%{x} · '+sc+': %{y:.1f}%<extra></extra>'}));
  if(rest.length) series.push({type:'scatter', mode:'lines', name:'Otros ('+rest.length+')', x, y:ALLP.map(p=>ES.filter(r=>r.period===p&&rest.includes(r.sector)).reduce((a,r)=>a+(r[hk]||0)*100,0)), line:{width:2, color:css('--muted'), dash:'dot'}, hovertemplate:'%{x} · otros: %{y:.1f}%<extra></extra>'});
  plot('c-hist-sector', series, base({xaxis:ax(), yaxis:Object.assign(base().yaxis,{ticksuffix:'%', rangemode:'tozero'}), margin:{l:8,r:16,t:8,b:90}, legend:{orientation:'h',y:-0.32,x:0}, hovermode:'x unified'}));
  const small = (id, y, fmt, suf) => plot(id, [{type:'scatter', mode:'lines', x, y, line:{width:2, color:css('--s1')}, fill:'tozeroy', fillcolor:'rgba(42,120,214,0.10)', hovertemplate:'%{x}: %{y'+fmt+'}'+suf+'<extra></extra>'}],
    base({xaxis:ax({nticks:8}), yaxis:Object.assign(base().yaxis,{ticksuffix:suf, rangemode:'tozero'}), showlegend:false, margin:{l:8,r:16,t:8,b:44}}));
  small('c-hist-mgrs', H.map(r=>r.n_managers), ':d', '');
  small('c-hist-top10', H.map(r=>r.avg_top10!=null?r.avg_top10*100:null), ':.0f', '%');
  small('c-hist-turnover', H.map(r=>r.avg_turnover!=null?r.avg_turnover*100:null), ':.0f', '%');
}
function renderLead(){
  const ins = DATA.insights[cur]; document.getElementById('headline').textContent = ins.headline;
  const k = DATA.kpis[cur]; const prev = prevOf(cur);
  const tiles = [
    {l:'Valor reportado', v:usd(k.total_value), d: k.total_value_chg==null?'primer trimestre del universo':`<span class="${k.total_value_chg>=0?'up':'down'}">${(k.total_value_chg*100).toFixed(1)}%</span> vs ${prev?ql(prev):''} <span title="Solo managers presentes en ambos trimestres; un filer que entra o sale del universo no cuenta como cambio">(mismos managers)</span>`},
    {l:'Flujo neto estimado', v:usd(k.net_flow), d:`bruto ${usd(k.gross_flow)} · efecto precio ${usd(k.price_effect)}`},
    {l:'Posiciones', v:(k.n_positions||0).toLocaleString(), d:`${k.n_new||0} nuevas · ${k.n_exit||0} salidas`},
    {l:'Rotación promedio', v:pct(k.avg_turnover,0), d:`${k.n_add||0} aumentos · ${k.n_trim||0} reducciones`},
  ];
  document.getElementById('kpis').innerHTML = tiles.map(t=>`<div class="kpi"><div class="l">${t.l}</div><div class="v">${t.v}</div><div class="d">${t.d}</div></div>`).join('');
  const TAG={flows:'Flujos',coverage:'Cobertura',asset_mix:'Activos',sector:'Sectores',sector_positioning:'Posicionamiento',sector_driver:'Sectores',sector_extremes:'Extremos',
             consensus_buy:'Consenso',consensus_sell:'Consenso',moves:'Movimientos',company_moves:'Empresas',turnover:'Rotación',type_mismatch:'Perfil',options:'Opciones'};
  document.getElementById('insights').innerHTML = ins.bullets.map(b=>`<li><span class="tag">${TAG[b.kind]||b.kind}</span><span>${esc(b.text)}</span></li>`).join('');
}

// ---------- asset mix
const ASSET_ORDER = DATA.asset_order;
function renderAsset(){
  const S = SERIES(); const key = wmode==='ew'?'avg_weight':'share'; const dkey = wmode==='ew'?'d_avg_weight':'d_share';
  const rows = DATA.exposure_asset;
  const traces = ASSET_ORDER.map((a,i)=>({type:'bar', name:a, x:P.map(ql), y:P.map(p=>{const r=rows.find(r=>r.period===p&&r.underlying_asset===a); return r&&r[key]!=null?r[key]*100:0;}),
    marker:{color:S[i%8], line:{width:2,color:css('--surface')}}, hovertemplate:'%{x} · '+a+': %{y:.1f}%<extra></extra>'}));
  plot('c-asset-mix', traces, base({barmode:'stack', bargap:0.35, yaxis:Object.assign(base().yaxis,{title:{text:'% del valor'},ticksuffix:'%'}), margin:{l:8,r:16,t:8,b:80}, legend:{orientation:'h',y:-0.2,x:0}}));
  const dr = ASSET_ORDER.map(a=>{const r=rows.find(r=>r.period===cur&&r.underlying_asset===a); return {a, d:r&&r[dkey]!=null?r[dkey]*100:0};}).sort((x,y)=>x.d-y.d);
  document.getElementById('asset-delta-label').textContent = prevOf(cur)?`${ql(prevOf(cur))} → ${ql(cur)}`:'';
  plot('c-asset-delta', [{type:'bar', orientation:'h', x:dr.map(r=>r.d), y:dr.map(r=>r.a), marker:{color:dr.map(r=>r.d>=0?css('--div-pos'):css('--div-neg'))},
    text:dr.map(r=>(r.d>=0?'+':'')+r.d.toFixed(2)+' pp'), textposition:'outside', textfont:{color:css('--ink2')}, cliponaxis:false, hovertemplate:'%{y}: %{x:+.2f} pp<extra></extra>'}],
    base({xaxis:Object.assign(base().xaxis,{ticksuffix:' pp',zeroline:true, range:divRange(dr.map(r=>r.d))}), margin:{l:8,r:16,t:8,b:36}, showlegend:false}));
}
// ---------- sectors
function renderSector(){
  const key = smode==='ew'?'avg_weight':'share'; const dkey = smode==='ew'?'d_avg_weight':'d_share';
  const modeLabel = smode==='ew'?'equal-weight':'por valor';
  document.getElementById('sector-mode-label').textContent = `(${modeLabel})`;
  document.getElementById('sector-delta-label').textContent = (prevOf(cur)?`${ql(prevOf(cur))} → ${ql(cur)}, `:'')+modeLabel;
  const rows = DATA.exposure_sector.filter(r=>r.period===cur&&r[key]!=null).sort((a,b)=>a[key]-b[key]);
  plot('c-sector-level', [{type:'bar', orientation:'h', x:rows.map(r=>r[key]*100), y:rows.map(r=>r.sector), marker:{color:css('--s1')},
    text:rows.map(r=>pct(r[key])), textposition:'outside', textfont:{color:css('--ink2')}, cliponaxis:false, hovertemplate:'%{y}: %{x:.1f}% ('+modeLabel+')<extra></extra>'}],
    base({xaxis:Object.assign(base().xaxis,{ticksuffix:'%'}), margin:{l:8,r:50,t:8,b:36}, showlegend:false}));
  const d = rows.filter(r=>r[dkey]!=null).sort((a,b)=>a[dkey]-b[dkey]);
  plot('c-sector-delta', [{type:'bar', orientation:'h', x:d.map(r=>r[dkey]*100), y:d.map(r=>r.sector), marker:{color:d.map(r=>r[dkey]>=0?css('--div-pos'):css('--div-neg'))},
    text:d.map(r=>pp(r[dkey])), textposition:'outside', textfont:{color:css('--ink2')}, cliponaxis:false, hovertemplate:'%{y}: %{x:+.2f} pp<extra></extra>'}],
    base({xaxis:Object.assign(base().xaxis,{ticksuffix:' pp',zeroline:true, range:divRange(d.map(r=>r[dkey]*100))}), margin:{l:8,r:16,t:8,b:36}, showlegend:false}));
  // heatmap: explicit height from the row count, otherwise Plotly's responsive sizing + automargin keeps growing the container
  const H = DATA.rotation.filter(r=>r.period===cur);
  const types=[...new Set(H.map(r=>r.manager_type))].sort(), secs=[...new Set(H.map(r=>r.sector))].sort();
  const heat=document.getElementById('c-rotation-heat');
  if(!types.length){ emptyChart(heat, 'Sin trimestre previo para calcular flujos.'); return; }
  const hh = Math.max(360, types.length*28 + 150); heat.style.height = hh+'px';
  const z = types.map(t=>secs.map(s=>{const r=H.find(r=>r.manager_type===t&&r.sector===s); return r?r.flow_pct*100:null;}));
  const m = Math.max(0.5, ...z.flat().filter(v=>v!=null).map(Math.abs));
  plot('c-rotation-heat', [{type:'heatmap', z, x:secs, y:types, zmin:-m, zmax:m, colorscale:[[0,css('--div-neg')],[0.5,css('--div-mid')],[1,css('--div-pos')]], xgap:2, ygap:2,
    hovertemplate:'%{y}<br>%{x}: %{z:+.2f}% del valor del grupo<extra></extra>', colorbar:{ticksuffix:'%', thickness:10, len:0.8, tickfont:{color:css('--muted')}, outlinewidth:0}}],
    base({height:hh, margin:{l:8,r:16,t:8,b:8}, xaxis:Object.assign(base().xaxis,{tickangle:-35, showgrid:false}), yaxis:Object.assign(base().yaxis,{showgrid:false, automargin:true})}));
}
// ---------- managers
function renderManagers(){
  const M = DATA.managers.filter(r=>r.period===cur).sort((a,b)=>b.total_value-a.total_value);
  const sz = M.map(r=>Math.max(8, 8 + 6*Math.log10(Math.max(1, r.total_value/1e8))));
  plot('c-mgr-scatter', [{type:'scatter', mode: mgrLabels?'markers+text':'markers', x:M.map(r=>r.n_positions), y:M.map(r=>r.top10_weight*100), text:M.map(r=>r.short), textposition:'top center', textfont:{color:css('--ink2'), size:11},
    marker:{size:sz, color:css('--s1'), opacity:0.85, line:{width:2, color:css('--surface')}},
    customdata:M.map(r=>[r.manager, usd(r.total_value), r.inferred_type, r.manager_type]),
    hovertemplate:'<b>%{customdata[0]}</b><br>%{x} posiciones · top-10 %{y:.0f}%<br>valor %{customdata[1]}<br>declarado: %{customdata[3]}<br>inferido: %{customdata[2]}<extra></extra>'}],
    base({xaxis:Object.assign(base().xaxis,{type:'log', title:{text:'Amplitud: número de posiciones (log)'}}), yaxis:Object.assign(base().yaxis,{title:{text:'Concentración: peso del top-10 (%)'}, ticksuffix:'%', range:[0,110]}), showlegend:false, margin:{l:8,r:16,t:16,b:48}}));
  const T = M.filter(r=>r.turnover!=null).sort((a,b)=>a.turnover-b.turnover);
  plot('c-mgr-turnover', [{type:'bar', orientation:'h', x:T.map(r=>r.turnover*100), y:T.map(r=>r.short), marker:{color:css('--s1')}, text:T.map(r=>pct(r.turnover,0)), textposition:'outside', textfont:{color:css('--ink2')}, cliponaxis:false,

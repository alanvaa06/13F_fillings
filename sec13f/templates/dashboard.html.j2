// ---------- moves
function movesTable(el, rows, withMgr){
  const mx = Math.max(1, ...rows.map(r=>Math.abs(r.flow_effect)));
  const cols = [];
  if(withMgr) cols.push({k:'short', h:'Manager', cls:'txt'});
  cols.push(
    {k:'action', h:'Acción', f:r=>`<span class="chip ${r.action}">${r.action}</span>`},
    {k:'issuer', h:'Emisor', cls:'txt', s:r=>title(r.issuer), f:r=>`${esc(title(r.issuer))}${r.put_call?' <span class="meta">('+r.put_call+')</span>':''}`},
    {k:'ticker', h:'Ticker', cls:'mono', f:r=>esc(r.ticker||'')},
    {k:'asset_type', h:'Tipo', cls:'txt'},
    {k:'sector', h:'Sector', cls:'txt'},
    {k:'pct_shares', h:'Δ títulos', cls:'num mono', tip:'Cambio % en el número de títulos; "nueva" = posición inexistente el trimestre previo', s:r=>r.pct_shares==null?1e9:r.pct_shares, f:r=>r.pct_shares==null?'nueva':((r.pct_shares>=0?'+':'')+(r.pct_shares*100).toFixed(0)+'%')},
    {k:'weight_prev', h:'Peso prev.', cls:'num mono', tip:'Peso de la posición en el libro del manager, trimestre previo', f:r=>pct(r.weight_prev)},
    {k:'weight_cur', h:'Peso actual', cls:'num mono', tip:'Peso de la posición en el libro del manager, trimestre actual', f:r=>pct(r.weight_cur)},
    {k:'d_weight', h:'Δ peso', cls:'num mono', s:r=>r.weight_cur-r.weight_prev, f:r=>signed(r.weight_cur-r.weight_prev, pp)},
    {k:'flow_effect', h:'Flujo estimado', cls:'num', tip:'Δ títulos × precio implícito del trimestre', f:r=>`<div class="bar-cell"><i class="${r.flow_effect<0?'neg':''}" style="width:${Math.max(2,Math.abs(r.flow_effect)/mx*60)}px"></i><span class="mono ${r.flow_effect>0?'up':'down'}">${usd(r.flow_effect)}</span></div>`},
  );
  buildTable(el, cols, rows, {empty:'Sin movimientos con estos filtros.', sticky: withMgr?3:2});  // frozen through "Emisor"
}
function renderMoves(){
  const mgr=document.getElementById('moves-mgr').value;
  const all = DATA.moves.filter(r=>r.period===cur && (amode==='ALL'||r.action===amode) && (mgr==='ALL'||r.cik===mgr));
  const rows = [...all].sort((a,b)=>Math.abs(b.flow_effect)-Math.abs(a.flow_effect)).slice(0,40);
  movesTable(document.getElementById('t-moves'), rows, true);
  document.getElementById('cap-moves').textContent = all.length>rows.length ? `${rows.length} de ${all.length} movimientos (mayor |flujo| primero)` : `${rows.length} movimientos`;
}
// ---------- companies (universe-wide aggregate per issuer)
const MAG_ES = {MAJOR:'Mayor', MINOR:'Menor', NONE:'Sin cambio'};
function renderCompanies(){
  const all = (DATA.companies||[]).filter(r=>r.period===cur);
  const kp = document.getElementById('companies-kpis');
  if(!all.length){
    kp.innerHTML=''; emptyChart(document.getElementById('c-companies-buy'), 'Sin trimestre previo para comparar.'); emptyChart(document.getElementById('c-companies-sell'), 'Sin trimestre previo para comparar.');
    document.getElementById('t-companies').innerHTML=''; document.getElementById('cap-companies').textContent=''; document.getElementById('companies-foot').textContent=''; return;
  }
  // KPIs come from full-universe totals computed in Python; the embedded rows are only the top movers per quarter.
  const T = (DATA.companies_totals||{})[cur] || {
    total:all.length, major:all.filter(r=>r.magnitude==='MAJOR').length, minor:all.filter(r=>r.magnitude==='MINOR').length, none:all.filter(r=>r.magnitude==='NONE').length,
    n_bought:all.filter(r=>r.net_flow>0).length, n_sold:all.filter(r=>r.net_flow<0).length,
    buy_flow:all.filter(r=>r.net_flow>0).reduce((a,r)=>a+r.net_flow,0), sell_flow:all.filter(r=>r.net_flow<0).reduce((a,r)=>a+r.net_flow,0),
    entries:all.filter(r=>r.holders_prev===0&&r.holders_cur>0).length, exits:all.filter(r=>r.holders_prev>0&&r.holders_cur===0).length };
  kp.innerHTML = [
    {l:'Emisoras en cartera', v:T.total.toLocaleString(), d:`${T.major.toLocaleString()} cambio mayor · ${T.minor.toLocaleString()} menor · ${T.none.toLocaleString()} sin cambio`},
    {l:'Compradas netas', v:T.n_bought.toLocaleString(), d:`flujo ${usd(T.buy_flow)}`},
    {l:'Vendidas netas', v:T.n_sold.toLocaleString(), d:`flujo ${usd(T.sell_flow)}`},
    {l:'Entradas / salidas del universo', v:`${T.entries.toLocaleString()} / ${T.exits.toLocaleString()}`, d:'emisoras que ningún manager tenía / que ya nadie tiene'},
  ].map(t=>`<div class="kpi"><div class="l">${t.l}</div><div class="v">${t.v}</div><div class="d">${t.d}</div></div>`).join('');
  // ranking charts
  const M = {
    flow:    {val:r=>r.net_flow/1e9, ok:r=>true, fmt:v=>usd(v*1e9), ax:{tickprefix:'$', ticksuffix:'B'}, label:'flujo neto, USD'},
    pct:     {val:r=>r.pct_shares*100, ok:r=>r.pct_shares!=null&&r.eligible_intensity, fmt:v=>(v>=0?'+':'')+v.toFixed(0)+'%', ax:{ticksuffix:'%'}, label:'Δ títulos agregados, emisoras con ≥3 tenedores'},
    breadth: {val:r=>r.net_buyers, ok:r=>true, fmt:v=>(v>0?'+':'')+v, ax:{}, label:'compradores − vendedores'},
  }[cmetric];
  const elig = all.filter(M.ok);
  const buys = elig.filter(r=>M.val(r)>0).sort((a,b)=>M.val(b)-M.val(a)).slice(0,15).reverse();
  const sells = elig.filter(r=>M.val(r)<0).sort((a,b)=>M.val(a)-M.val(b)).slice(0,15).reverse();
  document.getElementById('companies-buy-label').textContent = `(${M.label})`; document.getElementById('companies-sell-label').textContent = `(${M.label})`;
  document.getElementById('companies-foot').textContent = 'Barras = métrica seleccionada; el tooltip muestra compradores/vendedores, Δ títulos, flujo neto y tenedores. Solo acciones directas.';
  const rank = (id, rows, color, msg) => {
    const el=document.getElementById(id);
    if(!rows.length){ emptyChart(el, msg); return; }
    plot(id, [{type:'bar', orientation:'h', x:rows.map(M.val), y:rows.map(r=>title(r.issuer)), marker:{color:css(color)}, text:rows.map(r=>M.fmt(M.val(r))), textposition:'outside', textfont:{color:css('--ink2')}, cliponaxis:false,
      customdata:rows.map(r=>[r.buyers, r.sellers, r.pct_shares==null?'nueva':((r.pct_shares>=0?'+':'')+(r.pct_shares*100).toFixed(0)+'%'), usd(r.net_flow), r.holders_prev+' → '+r.holders_cur, r.sector]),
      hovertemplate:'<b>%{y}</b> · %{customdata[5]}<br>%{customdata[0]} compradores / %{customdata[1]} vendedores · tenedores %{customdata[4]}<br>Δ títulos %{customdata[2]} · flujo neto %{customdata[3]}<extra></extra>'}],
      base({xaxis:Object.assign(base().xaxis, M.ax, {zeroline:true, range:divRange([0, ...rows.map(M.val)])}), showlegend:false, margin:{l:8,r:16,t:8,b:36}}));
  };
  rank('c-companies-buy', buys, '--div-pos', 'Ninguna emisora con compra neta bajo esta métrica.');
  rank('c-companies-sell', sells, '--div-neg', 'Ninguna emisora con venta neta bajo esta métrica.');
  // table
  const secSel=document.getElementById('companies-sector'); const sv=secSel.value||'ALL';
  const secs=[...new Set(all.map(r=>r.sector))].sort();
  secSel.innerHTML='<option value="ALL">Todos</option>'+secs.map(s=>`<option value="${esc(s)}">${esc(s)}</option>`).join(''); secSel.value=[...secSel.options].some(o=>o.value===sv)?sv:'ALL';
  const rows = all.filter(r=>(cmag==='ALL'||r.magnitude===cmag)&&(secSel.value==='ALL'||r.sector===secSel.value));
  const magRank = {MAJOR:2, MINOR:1, NONE:0};
  buildTable(document.getElementById('t-companies'), [
    {k:'issuer', h:'Emisor', cls:'txt', s:r=>title(r.issuer), f:r=>`<strong>${esc(title(r.issuer))}</strong>`},
    {k:'sector', h:'Sector', cls:'txt'},
    {k:'magnitude', h:'Cambio neto', s:r=>magRank[r.magnitude], f:r=>`<span class="chip ${r.magnitude}">${MAG_ES[r.magnitude]||r.magnitude}</span>`},
    {k:'holders', h:'Tenedores', cls:'num mono', tip:'Managers con posición: trimestre previo → actual', s:r=>r.holders_cur, f:r=>`${r.holders_prev} → ${r.holders_cur}`},
    {k:'buyers', h:'Compr.', cls:'num mono', f:r=>`<span class="up">${r.buyers}</span>`},
    {k:'sellers', h:'Vend.', cls:'num mono', f:r=>`<span class="down">${r.sellers}</span>`},
    {k:'net_buyers', h:'Neto', cls:'num mono', tip:'Compradores − vendedores', f:r=>signed(r.net_buyers, v=>(v>0?'+':'')+v)},
    {k:'pct_shares', h:'Δ títulos', cls:'num mono', tip:'Variación % de los títulos agregados del universo; "nueva" = ningún manager la tenía', s:r=>r.pct_shares==null?1e9:r.pct_shares, f:r=>r.pct_shares==null?'nueva':signed(r.pct_shares, v=>(v>=0?'+':'')+(v*100).toFixed(1)+'%')},
    {k:'net_flow', h:'Flujo neto', cls:'num mono', tip:'Compras − ventas al precio implícito del trimestre', f:r=>signed(r.net_flow, usd)},
    {k:'gross_flow', h:'Flujo bruto', cls:'num mono', tip:'Compras + ventas', f:r=>usd(r.gross_flow)},
    {k:'price_effect', h:'Efecto precio', cls:'num mono', f:r=>signed(r.price_effect, usd)},
    {k:'value_cur', h:'Valor agregado', cls:'num mono', tip:'Valor total en manos del universo, trimestre actual', f:r=>usd(r.value_cur)},
  ], rows, {defaultKey:'gross_flow', defaultDir:-1, sticky:1, empty:'Sin emisoras con estos filtros.'});
  document.getElementById('cap-companies').textContent = T.total>all.length
    ? `${rows.length.toLocaleString()} filas · el dashboard incluye las ${all.length.toLocaleString()} emisoras con más movimiento de las ${T.total.toLocaleString()} en cartera en ${ql(cur)} (la lista completa está en company_moves.csv)`
    : `${rows.length.toLocaleString()} de ${T.total.toLocaleString()} emisoras en ${ql(cur)}`;
}
// ---------- consensus
function renderConsensus(){
  const C = DATA.consensus.filter(r=>r.period===cur);
  const issuerCol = {k:'issuer', h:'Emisor', cls:'txt', s:r=>title(r.issuer), f:r=>esc(title(r.issuer))};
  const held = [...C].sort((a,b)=>b.holders-a.holders||b.total_value-a.total_value).slice(0,12);
  buildTable(document.getElementById('t-held'), [issuerCol,
    {k:'holders', h:'Tenedores', cls:'num mono'}, {k:'total_value', h:'Valor', cls:'num mono', f:r=>usd(r.total_value)},
    {k:'net_buyers', h:'Neto', cls:'num mono', tip:'Compradores − vendedores', f:r=>signed(r.net_buyers??0, v=>(v>0?'+':'')+v)}], held, {sticky:1});
  const bought=[...C].filter(r=>r.net_buyers>0).sort((a,b)=>b.net_buyers-a.net_buyers||b.net_flow-a.net_flow).slice(0,12);
  buildTable(document.getElementById('t-bought'), [issuerCol,
    {k:'buyers', h:'Compr.', cls:'num mono', f:r=>`<span class="up">${r.buyers}</span>`}, {k:'sellers', h:'Vend.', cls:'num mono'}, {k:'new_holders', h:'Nuevos', cls:'num mono'},
    {k:'net_flow', h:'Flujo', cls:'num mono', f:r=>usd(r.net_flow)}], bought, {empty:'Sin compras de consenso.', sticky:1});
  const sold=[...C].filter(r=>r.net_buyers<0).sort((a,b)=>a.net_buyers-b.net_buyers||a.net_flow-b.net_flow).slice(0,12);
  buildTable(document.getElementById('t-sold'), [issuerCol,
    {k:'sellers', h:'Vend.', cls:'num mono', f:r=>`<span class="down">${r.sellers}</span>`}, {k:'buyers', h:'Compr.', cls:'num mono'}, {k:'exits', h:'Salidas', cls:'num mono'},
    {k:'net_flow', h:'Flujo', cls:'num mono', f:r=>usd(r.net_flow)}], sold, {empty:'Sin ventas de consenso.', sticky:1});
}
